// Problem 04: Elephant - Codeforces.
// Calculate the minimum number of steps needed for an elephant to reach position x,
// where the elephant can move 1 to 5 positions in a single step.

#include <stdio.h>
int main()
{
    int i,x,step=0;
    scanf("%d",&x);

    for(i=5;i<=x;i=i+5)
    {

        step=step+1;

    }
    step=step+(x%5!=0);
    printf("Steps : %d",step);
}
